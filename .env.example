# 실제 비밀값을 이 예제에 기록하지 않습니다.
# 데이터베이스 주소는 Go MySQL 드라이버 형식입니다. URL 형식이 아닙니다.
COTRADER_DATABASE_URL=cotrader:local-development-only@tcp(127.0.0.1:13316)/cotrader

# 시장별 주문 스위치. 켜지 않으면 잔고 조회와 대조만 동작합니다.
COTRADER_TOSS_ORDERS_ENABLED=false
COTRADER_UPBIT_KRW_ORDERS_ENABLED=false
COTRADER_UPBIT_USDT_ORDERS_ENABLED=false

# 업비트 메인 포켓과 코트레이더 포켓 사이의 자산 이동.
COTRADER_UPBIT_TRANSFERS_ENABLED=false

# 화면에 표시할 포켓 이름입니다. 키를 선택하지 않습니다.
COTRADER_UPBIT_ACCOUNT_LABEL=코트레이더 포켓

# 아래 값은 배포 시 Secret으로 주입합니다.
# TELEGRAM_API_KEY=
# TELEGRAM_ME=
# TOSS_INVEST_OPEN_API_CLIENT_ID=
# TOSS_INVEST_OPEN_API_CLIENT_SECRET=
# COTRADER_ACCOUNT_SEQ=
# 주문과 잔고 조회에 쓰는 코트레이더 포켓 키
# UPBIT_COTRADER_ACCESS_KEY=
# UPBIT_COTRADER_SECRET_KEY=
# 메인 포켓 잔고 조회 키
# UPBIT_MAIN_ACCESS_KEY=
# UPBIT_MAIN_SECRET_KEY=
# 포켓 간 이체 키. 이체를 켤 때만 필요합니다.
# UPBIT_POCKET_ADMIN_ACCESS_KEY=
# UPBIT_POCKET_ADMIN_SECRET_KEY=
