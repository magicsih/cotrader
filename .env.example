# 실제 비밀값을 이 예제에 기록하지 않습니다. 기본 실행은 외부 API를 호출하지 않습니다.
COTRADER_DATABASE_URL=mysql+asyncmy://cotrader:local-development-only@127.0.0.1:13316/cotrader
COTRADER_AUTH_MODE=local
COTRADER_PUBLIC_URL=http://127.0.0.1:8000
COTRADER_MARKET_SOURCE=offline
COTRADER_LIVE_ENABLED=false
COTRADER_ACCOUNT_READS_ENABLED=false
COTRADER_TELEGRAM_ENABLED=false
COTRADER_CAPITAL_USD=5000
COTRADER_DAILY_LOSS_USD=50
COTRADER_DRAWDOWN_USD=250
COTRADER_UPBIT_ENABLED=false
COTRADER_UPBIT_LIVE_ENABLED=false
COTRADER_UPBIT_USDT_LIVE_ENABLED=false
COTRADER_CAPITAL_USDT=500
COTRADER_DAILY_LOSS_USDT=5
COTRADER_DRAWDOWN_USDT=25
COTRADER_UPBIT_ACCOUNT_READS_ENABLED=false
COTRADER_CAPITAL_KRW=1000000
COTRADER_DAILY_LOSS_KRW=10000
COTRADER_DRAWDOWN_KRW=50000
